cat > scripts/featureCounts_GSE181559_trimmed.sbatch <<'EOF'
#!/usr/bin/env bash
#SBATCH --job-name=FC_GSE181559_trim
#SBATCH --partition=compute
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=32G
#SBATCH --time=08:00:00
#SBATCH --output=/data2/doucetohare_lab/farunim/Neuroblastoma/patient/GSE181559/logs/featureCounts_trimmed.%j.out
#SBATCH --error=/data2/doucetohare_lab/farunim/Neuroblastoma/patient/GSE181559/logs/featureCounts_trimmed.%j.err

set -euo pipefail

module purge >/dev/null 2>&1 || true
module load subread/1.6.4

BASE=/data2/doucetohare_lab/farunim/Neuroblastoma/patient/GSE181559
BAMDIR=${BASE}/STAR_trimmed
SAMPLES=${BASE}/SRR_Acc_List.txt
OUTDIR=${BASE}/gene_counts

GTF=/scratch2/farunim/AIM1/reference/gencode.v46.annotation.gtf

mkdir -p "${OUTDIR}"

echo "============================================"
echo "[INFO] Start: $(date)"
echo "[INFO] Host: $(hostname)"
echo "[INFO] Samples: $(wc -l < "${SAMPLES}")"
echo "[INFO] GTF: ${GTF}"
echo "============================================"

BAMS=()

while read -r sample; do

    bam="${BAMDIR}/${sample}.Aligned.sortedByCoord.out.bam"

    if [[ ! -s "${bam}" ]]; then
        echo "[ERROR] Missing BAM: ${bam}"
        exit 1
    fi

    BAMS+=("${bam}")

done < "${SAMPLES}"

echo "[INFO] BAMs supplied to featureCounts: ${#BAMS[@]}"

if [[ ${#BAMS[@]} -ne 97 ]]; then
    echo "[ERROR] Expected 97 BAMs but found ${#BAMS[@]}"
    exit 1
fi

featureCounts \
    -T "${SLURM_CPUS_PER_TASK}" \
    -a "${GTF}" \
    -o "${OUTDIR}/GSE181559_97_gene_counts.txt" \
    -t exon \
    -g gene_id \
    -p \
    -B \
    -C \
    -s 0 \
    "${BAMS[@]}"

echo "============================================"
echo "[DONE] featureCounts"
echo "[DONE] $(date)"
echo "[OUTPUT] ${OUTDIR}/GSE181559_97_gene_counts.txt"
echo "============================================"
EOF
